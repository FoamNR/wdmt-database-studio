{
  "name": "wdmt",
  "version": "1.0.0",
  "description": "Web-based Database Management Tool",
  "type": "module",
  "main": "dist-server/server/index.js",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "npm --prefix client run dev",
    "dev": "npx concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client run build",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node --import tsx server/index.ts"
  },
  "keywords": [
    "database",
    "sql-editor",
    "postgres",
    "mysql",
    "sqlite",
    "mssql",
    "web-client",
    "database-manager"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1",
    "ssh2": "^1.17.0",
    "tedious": "^18.6.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ssh2": "^1.15.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
